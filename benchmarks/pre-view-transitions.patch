+  default?: ViewTransitionClass
+  enter?: ViewTransitionClass
+  exit?: ViewTransitionClass
+  update?: ViewTransitionClass
+  share?: ViewTransitionClass
+  onEnter?: (instance: any, types: string[]) => void | (() => void)
+  onExit?: (instance: any, types: string[]) => void | (() => void)
+  onUpdate?: (instance: any, types: string[]) => void | (() => void)
+  onShare?: (instance: any, types: string[]) => void | (() => void)
+}
