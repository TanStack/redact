+// A distinct boundary preserves identity without introducing deferred commits.
+// Redact's synchronous transitions do not take browser animation snapshots.
+export const ViewTransition = REACT_VIEW_TRANSITION_TYPE as unknown as (props: ViewTransitionProps) => any
