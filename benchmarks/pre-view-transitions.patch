+  if (!(fiber.root ?? findRoot(fiber))?.a) return false
+  for (let parent: Fiber | null = fiber; parent; parent = parent.parent) {
+    if (parent.tag === FiberTag.Activity && parent.pp?.mode === 'hidden') return true
