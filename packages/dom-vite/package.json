{
  "name": "@tanstack/dom-vite",
  "version": "0.1.0-alpha.6",
  "description": "Vite plugin — installs tanstack-react in place of react/react-dom.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "dependencies": {
    "@tanstack/dom-core": "workspace:*",
    "@tanstack/scheduler": "workspace:*",
    "@tanstack/react": "workspace:*",
    "@tanstack/react-dom": "workspace:*",
    "@tanstack/react-dom-server": "workspace:*"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "scripts": {
    "build": "echo done-by-root-build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
